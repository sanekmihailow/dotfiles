### "\[\e[32m\]" = "\[\033[0;32m\]"
## see https://misc.flogisoft.com/bash/tip_colors_and_formatting
fg_1='\[\e[1m\]'
fg_LIGHTGREEN='\[\e[1;92m\]'
fg_GREEN='\[\e[01;32m\]'
fg_green='\[\e[32m\]'
fg_LIGHTRED='\[\e[1;91m\]'
fg_red='\[\e[31m\]'
fg_lightgray='\[\e[37m\]'
fg_dimyellow='\[\e[22;33m\]'
fg_lightyellow='\[\e[0;93m\]'
fg_CYAN='\[\e[1;36m\]'
fg_LIGHTBLUE='\[\e[1;94m\]'
fg_lightblue='\[\e[0;94m\]'
bg_LIGHTRED='\[\e[1;101m\]'
reset_NC='\[\e[0m\]'

# cmd execution timer (shows elapsed if > 1 min in PS1)
_cmd_prompt_running=0
_cmd_elapsed_str=''
_last_exit_code=0

_cmd_timer_preexec() {
    if [[ $_cmd_prompt_running == 0 ]]; then
        _cmd_timer=${_cmd_timer:-$SECONDS}
    fi
}

_cmd_timer_precmd() {
    _cmd_prompt_running=1

    # log successful commands to ~/.bash_history_success
    if [[ $_last_exit_code -eq 0 ]]; then
        local last_cmd
        last_cmd=$(tail -n1 ~/.bash_history 2>/dev/null)
        if [[ -n "$last_cmd" && "$last_cmd" != \#* ]]; then
            #echo "$(date '+%F %T') $last_cmd" >> ~/.bash_history_success
            printf '#%s\n%s\n' "$(date '+%s')" "$last_cmd" >> ~/.bash_history_success
        fi
    fi

    # execution timer: show if >= 60s, or any duration on failure
    if [[ -n "$_cmd_timer" ]]; then
        local elapsed=$(( SECONDS - _cmd_timer ))
        if (( elapsed >= 60 )) || [[ $_last_exit_code -ne 0 && elapsed -ge 1 ]]; then
            local mins=$(( elapsed / 60 ))
            local secs=$(( elapsed % 60 ))
            _cmd_elapsed_str="[${mins}m${secs}s]"
        else
            _cmd_elapsed_str=''
        fi
        unset _cmd_timer
    fi

    _cmd_prompt_running=0
}

_precmd_wrapper() {
    _last_exit_code=$?   # capture before anything else runs
    history -a           # flush to file — last_cmd readable after this
    _cmd_timer_precmd
    history -c
    history -r
}

if [[ "$TERM" =~ "screen" ]]; then
    _debug_combined() {
        _cmd_timer_preexec
        set_screen_window
    }
    trap '_debug_combined' DEBUG
else
    trap '_cmd_timer_preexec' DEBUG
fi


if [ -n "$force_color_prompt" ]; then
    if [ -x /usr/bin/tput ] && tput setaf 1 >&/dev/null; then
        # We have color support; assume it's compliant with Ecma-48
        # (ISO/IEC-6429). (Lack of such support is extremely rare, and such
        # a case would tend to support setf rather than setaf.)
        color_prompt=yes
    else
        color_prompt=
    fi
fi

PROMPT_COMMAND="_precmd_wrapper"
export -n PROMPT_COMMAND
if [ "$color_prompt" = yes ]; then
    PS1=" $(move_cursor_to_end_line) \`if [ \$? = 0 ]; then echo -e \"${fg_green} \xE2\x9C\x85 ${reset_NC}\"; else echo -e \"${fg_red} \xE2\x9D\x8C ${reset_NC}\"; fi\` "
    PS1+="${debian_chroot:+($debian_chroot)} ${fg_GREEN} ${fg_lightyellow}\n#----------------${reset_NC}"
    PS1+="${fg_lightgray}(\H)${reset_NC} "
    PS1+="${fg_1}\#-[\$(if [ \${MC_SID} ]; then echo -e \"${fg_LIGHTBLUE}\xF0\x9F\x92\xBE${reset_NC}\"; fi)\d]${reset_NC} "
    PS1+="$fg_lightgray[$WhatItPC]$reset_NC "
    PS1+="${fg_lightblue}\$(git_getbranch)${reset_NC}"
    PS1+="\$(git_getorigin) $(move_cursor_to_end_line) \${_cmd_elapsed_str}\n ${fg_dimyellow}\t${reset_NC}"
    PS1+="${fg_lightyellow}j=\j${reset_NC} "
    PS1+="${fg_GREEN}\u${reset_NC}"
    PS1+="@${fg_CYAN}\h${reset_NC}: "
    PS1+="${fg_LIGHTBLUE}\w${reset_NC}"
    PS1+="\n \n "
    PS1+="${fg_LIGHTGREEN}\$ ${reset_NC}"
else
    PS1="(\H) #-[\d] \t \${_cmd_elapsed_str}j=\j \u@\h: \w \n > "
fi

unset color_prompt force_color_prompt
case "$TERM" in
xterm*|rxvt*)
    PS1="\[\e]0;${debian_chroot:+($debian_chroot)}\u@\h: \w\a\]$PS1" ;;
*) ;;
esac
