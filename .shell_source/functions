dumper() {
# tcpdump wrapper: separates each packet with a blank line for readability
# Usage: dumper [def|def-ext] [TCPDUMP OPTIONS] [FILTER]
    local help_text
    help_text=$(cat <<'EOF'
dumper - tcpdump wrapper with visual packet separation

USAGE:
    dumper [PRESET] [TCPDUMP OPTIONS] [FILTER EXPRESSION]

PRESETS:
    def         --nnvv -i any  (no DNS resolve, verbose, all interfaces)
    def-ext     --nnvv -A -s0 -i any  (+ ASCII payload, full snaplen)

DESCRIPTION:
    Runs tcpdump and inserts a blank line before each new packet.
    Multi-line verbose output (-v, -vv) stays grouped — blank line
    is added only before a new timestamp line, not between its lines.

EXAMPLES:
    dumper def
    dumper def port 80
    dumper def-ext host 192.168.1.1
    dumper -i eth0 -n port 80
    dumper -i eth0 -vv -e tcp and port 443
EOF
)
    local sudo_used=''
    if [[ $EUID -ne 0 ]]; then
        if $(sudo -v 2>/dev/null); then sudo_used='sudo'; fi
    fi

    local tcpdump_args=()
    case "$1" in
        -h|--help|help) echo "$help_text"; return ;;
        def)     shift; tcpdump_args=(-nnvv -i any) ;;
        def-ext) shift; tcpdump_args=(-nnvv -A -s0 -i any) ;;
    esac

    ${sudo_used} tcpdump "${tcpdump_args[@]}" "$@" 2>&1 | sed -E '1!s/^[0-9]{2}:[0-9]{2}:[0-9]{2}\./\n&/'
}

infinity_loop() {
# repeat command in a loop with interval
# Usage: dumper infinity_loop [INTERVAL] [--count=N] [--clear] <COMMAND>
    local help_text
    local interval='1'
    local count=0
    local clear=false
    local iteration=0
    local cmd=()
    local help_text
    help_text=$(cat <<'EOF'
infinity_loop - repeat a command in a loop

USAGE:
    infinity_loop [INTERVAL] [OPTIONS] <command>

ARGUMENTS:
    INTERVAL    Pause between runs, passed directly to sleep (default: 1)
                Format: NUMBER[s|m|h]  e.g. 5, 2s, 1m, 0.5

OPTIONS:
    --count=N   Stop after N iterations (default: infinite)
    --clear     Clear screen before each run
    -h, --help  Show this help

EXAMPLES:
    infinity_loop date
    infinity_loop 5 curl -s http://localhost/health
    infinity_loop 2s --count=10 uptime
    infinity_loop 1m --clear df -h
EOF
)

    if [[ "$1" =~ ^[0-9]+(\.[0-9]+)?[smhd]?$ ]]; then
        interval="$1"
        shift
    fi

    while [[ "$#" -gt 0 ]]; do
        case "$1" in
            -h|--help|help) echo "$help_text"; return ;;
            --count=*)      count="${1#*=}" ;;
            --clear)        clear=true ;;
            *)              cmd+=("$1") ;;
        esac
        shift
    done

    if [[ ${#cmd[@]} -eq 0 ]]; then
        echo "$help_text"; return 1
    fi

    while true; do
        $clear && clear
        "${cmd[@]}"
        iteration=$((iteration + 1))
        if [[ $count -gt 0 && $iteration -ge $count ]]; then break; fi
        sleep "$interval"
    done
}

genpass() {
# generate random password: genpass [LENGTH] [--exclude=CHARS] [--alnum]
#   genpass
#   genpass 32
#   genpass 16 --exclude='@!'
    local length=20
    local extra_exclude=''
    local only_num=false
    local no_special=false
    local base_exclude=$'\'\"$#\\\\*`;&|<>'
    local help_text
    help_text=$(cat <<'EOF'
genpass - generate a random password

USAGE:
    genpass [LENGTH] [OPTIONS]

ARGUMENTS:
    LENGTH          Password length (default: 20)

OPTIONS:
    --exclude=CHARS Additional characters to exclude
    --onlynum       Digits only
    --nospec        Alphanumeric only (letters + digits)
    -h, --help      Show this help

DEFAULT EXCLUDED: ' " $ # \ * ` ; & | < >

EXAMPLES:
    genpass
    genpass 32
    genpass 16 --exclude='@'
    genpass --onlynum
EOF
)

    if [[ "$1" =~ ^[0-9]+$ ]]; then
        length="$1"
        shift
    fi

    while [[ "$#" -gt 0 ]]; do
        case "$1" in
            -h|--help|help) echo "$help_text"; return ;;
            --exclude=*)    extra_exclude="${1#*=}" ;;
            --onlynum)      only_num=true ;;
            --nospec)       no_special=true ;;
            *) echo "genpass: unknown option: $1" >&2; return 1 ;;
        esac
        shift
    done

    if $only_num; then
        tr -dc '0-9' < /dev/urandom | tr -d "${extra_exclude}" | head -c "$length"
    fi

    if [ "$no_special" = true ] && [ "$only_num" = false ] ; then
        tr -dc 'A-Za-z0-9' < /dev/urandom | tr -d "${extra_exclude}" | head -c "$length"
    fi
    
    if [ "$only_num" = false ] && [ "$no_special" = false ]; then
        tr -dc '_^%.,<>!-~?' < /dev/urandom | tr -d "${base_exclude}${extra_exclude}" | head -c "$length"
    fi
}

tailf() {
# Watch files/dirs / stream grep-filtered output (like multitail -f)
# Usage: tailf [OPTIONS] FILE|DIR [FILE|DIR ...]
#   tailf -e 'error' /var/log/syslog /var/log/auth.log
#   tailf -e 'WARN|ERROR' /var/log /opt/app/logs
#   tailf --temp -r -e 'exception' /var/log    # also write to /tmp/tailf_<timestamp>.log
    local n=0
    local recursive=false
    local use_temp=false
    local pattern="."
    local dirs=()
    local help_text
    help_text=$(cat <<'EOF'
tailf - watch files in directories or stream grep-filtered output

USAGE:
    tailf [OPTIONS] FILE|DIR [FILE|DIR ...]

ARGUMENTS:
    FILE|DIR    One or more files or directories to watch

OPTIONS:
    -e PATTERN  Extended regex to filter lines (default: match all)
    -n N        Show last N lines on start (default: 0 = new lines only)
    -r          Watch subdirectories recursively (dirs only)
    --temp      Also write output to /tmp/tailf_<timestamp>.log
    -h, --help  Show this help

EXAMPLES:
    tailf /var/log
    tailf -e 'error' /var/log/syslog /var/log/auth.log
    tailf -e 'WARN|ERROR' /var/log /opt/app/logs
    tailf -r -n 10 -e 'GET' /var/log/nginx
    tailf --temp -e 'exception' /var/log /home/user/app/logs
EOF
)

    while [[ "$#" -gt 0 ]]; do
        case "$1" in
            -h|--help|help) echo "$help_text"; return 0 ;;
            -e)             pattern="$2"; shift ;;
            -e*)            pattern="${1#-e}" ;;
            -n)             n="$2"; shift ;;
            -n[0-9]*)       n="${1#-n}" ;;
            -r|--recursive) recursive=true ;;
            --temp)         use_temp=true ;;
            -*)             echo "tailf: unknown option: $1" >&2; return 1 ;;
            *)              dirs+=("$1") ;;
        esac
        shift
    done

    if [[ ${#dirs[@]} -eq 0 ]]; then
        echo "tailf: no path specified" >&2; echo "$help_text" >&2; return 1
    fi

    local d
    for d in "${dirs[@]}"; do
        if [[ ! -e "$d" ]]; then
            echo "tailf: '$d' does not exist" >&2; return 1
        fi
    done

    # Setup temp file (no tee dependency — dual write inside the loop)
    local tmpfile=""
    if $use_temp; then
        tmpfile="/tmp/tailf_$(date +%Y%m%d_%H%M%S).log"
        echo "tailf: output also written to $tmpfile" >&2
        touch "$tmpfile"
    fi

    local colors=($'\e[31m' $'\e[32m' $'\e[33m' $'\e[34m' $'\e[35m' $'\e[36m')
    local nc=${#colors[@]}
    local cidx=0

    local pid_file
    pid_file=$(mktemp)

    # Disable job control notifications ([1] pid) for the duration of the function
    local _mon=0; [[ $- == *m* ]] && _mon=1
    set +m

    _tailf_cleanup() {
        local pid
        while IFS= read -r pid; do
            kill "$pid" 2>/dev/null
        done < "$pid_file"
        rm -f "$pid_file"
        [[ $_mon -eq 1 ]] && set -m
        trap - INT TERM
    }
    trap '_tailf_cleanup' INT TERM

    declare -A _tailf_watched

    local find_opts=()
    $recursive || find_opts+=(-maxdepth 1)

    echo "tailf: watching [${dirs[*]}] | pattern: '$pattern' | recursive: $recursive" >&2

    _tailf_watch_file() {
        local file="$1"
        [[ "${_tailf_watched[$file]+x}" ]] && return
        _tailf_watched[$file]=1
        local col="${colors[$((cidx % nc))]}"
        local fname="${file##*/}"
        (( cidx++ ))
        (
            tail -F -n "$n" "$file" 2>/dev/null \
            | grep --line-buffered -E "$pattern" \
            | while IFS= read -r line; do
                printf "%s[%s]\e[0m %s\n" "$col" "$fname" "$line"
                [[ -n "$tmpfile" ]] && printf "%s[%s]\e[0m %s\n" "$col" "$fname" "$line" >> "$tmpfile"
              done
        ) &
        echo $! >> "$pid_file"
    }

    local path file
    while true; do
        for path in "${dirs[@]}"; do
            if [[ -f "$path" ]]; then
                _tailf_watch_file "$path"
            elif [[ -d "$path" ]]; then
                while IFS= read -r -d '' file; do
                    _tailf_watch_file "$file"
                done < <(find "$path" "${find_opts[@]}" -type f -print0 2>/dev/null)
            fi
        done
        sleep 1
    done
}

syslog_pretty() {
# Usage: syslog_pretty --col-start="<Number>" [-s] [-j] ["log line"]
# Example: tail -f /var/log/slapd.log | syslog_pretty -s
# Example: syslog_pretty "[date] conn=1 op=0 RESULT err=0 tag=101"
# Example: cat /var/log/k3s.log | syslog_pretty -j | grep '"err":[^0]'
    local sep=0 json_mode=0 col_spec=""
    local indent="    "
    local help_text
    help_text=$(cat <<'EOF'
syslog_pretty [-s] [-j] ["log line"]

Expand a syslog/log line into a readable multi-line format.
Each key=value pair gets its own indented line. JSON values are
pretty-printed. Reads from stdin if no argument is given.

OPTIONS
  -s            print a blank separator line between log entries
  -j            output as JSON (JSONL: one object per line, then pretty-printed)
  --col-start   change time column

SUPPORTED FORMATS
  [timestamp] key=val ...         OpenLDAP / nginx
  Mon DD HH:MM:SS host proc: ...  BSD syslog
  YYYY-MM-DD HH:MM:SS [LEVEL] ... app logs (journald, etc.)
  TIMESTAMP host proc[pid]: ...   ISO / RFC5424 syslog
  + klog sub-header inside any of the above (k3s / kubelet)

JSON OUTPUT FIELDS
  _time     syslog header / timestamp
  _klog     klog sub-header (k3s/kubelet), if present
  _message  standalone quoted message, if present
  _text     bare-word tokens that don't map to a key=value
  <key>     all key=value pairs; numeric/bool/null/JSON values typed natively

EXAMPLES
  syslog_pretty "[10/Feb/2026:15:28:58 +0300] conn=38 op=5 RESULT err=0"
  tail -f /var/log/slapd.log | syslog_pretty -s
  cat /var/log/k3s.log | syslog_pretty -j | grep '"err":[^0]'
  cat /var/log/nginx/access.log | syslog_pretty --col-start="4,5" # or --col-start="4-5"
EOF
)
    while [[ "$#" -gt 0 ]]; do
        case "$1" in
            -h|--help|help)    echo "$help_text"; return 0 ;;
            -s)                sep=1 ;;
            -j|--json)         json_mode=1 ;;
            --col-start=*)     col_spec="${1#--col-start=}" ;;
            -*)                echo "syslog_pretty: unknown option: $1" >&2; return 1 ;;
            *)              break ;;
        esac
        shift
    done

    # _jsonfmt: pretty-print a single JSON value from stdin (2-space indent)
    # _jsonfmt_jsonl: pretty-print a stream of compact JSON objects (one per line)
    if   command -v jq      >/dev/null 2>&1; then
        _jsonfmt()       { jq --indent 2 .; }
        _jsonfmt_jsonl() { jq .; }
    elif command -v python3 >/dev/null 2>&1; then
        _jsonfmt()       { python3 -c "import json,sys; print(json.dumps(json.load(sys.stdin),indent=2))"; }
        _jsonfmt_jsonl() { python3 -c "import json,sys; [print(json.dumps(json.loads(l),indent=2)) for l in sys.stdin if l.strip()]"; }
    elif command -v python >/dev/null 2>&1; then
        _jsonfmt()       { python -c "import json,sys; print(json.dumps(json.load(sys.stdin),indent=2))"; }
        _jsonfmt_jsonl() { python  -c "import json,sys; [print(json.dumps(json.loads(l),indent=2)) for l in sys.stdin if l.strip()]"; }
    else
        _jsonfmt() {
            awk '
            function print_indent(    i) { for (i=0; i<depth; i++) printf "  " }
            function flush_newline()     { if (after_open) { printf "\n"; print_indent(); after_open=0 } }
            BEGIN { depth=0; in_str=0; after_open=0 }
            {
                n = length($0)
                for (i = 1; i <= n; i++) {
                    c = substr($0, i, 1)
                    if (in_str) {
                        flush_newline(); printf "%s", c
                        if      (c == "\\") { i++; printf "%s", substr($0,i,1) }
                        else if (c == "\"")   in_str = 0
                        continue
                    }
                    if (c == " " || c == "\t" || c == "\r") continue
                    switch (c) {
                    case "{": case "[":
                        flush_newline(); printf "%s", c; depth++; after_open=1; break
                    case "}": case "]":
                        if (after_open) { after_open=0; depth-- }
                        else            { printf "\n"; depth--; print_indent() }
                        printf "%s", c
                        if (depth == 0) printf "\n"
                        break
                    case ",":
                        flush_newline(); printf "%s", c; after_open=1; break
                    case ":":
                        flush_newline(); printf ": "; break
                    case "\"":
                        flush_newline(); in_str=1; printf "\""; break
                    default:
                        flush_newline(); printf "%s", c
                    }
                }
            }
            END { printf "\n" }
            '
        }
        _jsonfmt_jsonl() { _jsonfmt; }
    fi

    _syslog_pretty_awk() {
        awk -v indent="$indent" -v sep="$sep" -v json_mode="$json_mode" -v col_spec="$col_spec" '

        BEGIN {
            col_s = 0; col_e = 0
            if (col_spec != "") {
                if (col_spec ~ /^[0-9]+-[0-9]+$/) {
                    split(col_spec, _p, "-"); col_s = _p[1]+0; col_e = _p[2]+0
                } else if (col_spec ~ /,/) {
                    n = split(col_spec, _p, ",")
                    col_s = _p[1]+0; col_e = _p[n]+0
                } else {
                    col_s = col_spec+0; col_e = col_spec+0
                }
            }
        }

        function tokenize(line,    raw, n, i, tok, q) {
            delete _tok
            n = split(line, raw, " ")
            _ntok = 0; i = 1
            while (i <= n) {
                tok = raw[i]
                q = tok; gsub(/\\./, "", q); gsub(/[^"]/, "", q)
                if (length(q) % 2 == 1) {
                    while (i < n) {
                        i++; tok = tok " " raw[i]
                        q = raw[i]; gsub(/\\./, "", q); gsub(/[^"]/, "", q)
                        if (length(q) % 2 == 1) break
                    }
                }
                if (tok != "") _tok[++_ntok] = tok
                i++
            }
            return _ntok
        }

        function json_escape(s) {
            gsub(/\\/, "\\\\", s); gsub(/"/, "\\\"", s)
            gsub(/\n/, "\\n",  s); gsub(/\r/, "\\r", s); gsub(/\t/, "\\t", s)
            return s
        }
        function json_str(s) { return "\"" json_escape(s) "\"" }
        function unescape_go(s,    result, i, c, nc) {
            result = ""; i = 1
            while (i <= length(s)) {
                c = substr(s, i, 1)
                if (c == "\\") {
                    nc = substr(s, i+1, 1)
                    if      (nc == "\"") { result = result "\""; i += 2 }
                    else if (nc == "\\") { result = result "\\"; i += 2 }
                    else if (nc == "n")  { result = result "\n"; i += 2 }
                    else if (nc == "t")  { result = result "\t"; i += 2 }
                    else if (nc == "r")  { result = result "\r"; i += 2 }
                    else                 { result = result c;    i++    }
                } else {
                    result = result c; i++
                }
            }
            return result
        }
        function wordwrap(s, maxlen,    words, nw, i, line, result, sep) {
            nw = split(s, words, " ")
            line = ""; result = "["; sep = ""
            for (i = 1; i <= nw; i++) {
                if (line == "")
                    line = words[i]
                else if (length(line) + 1 + length(words[i]) <= maxlen)
                    line = line " " words[i]
                else {
                    result = result sep json_str(line); sep = ","
                    line = words[i]
                }
            }
            if (line != "") result = result sep json_str(line)
            return result "]"
        }
        function json_val(s) {
            if (s ~ /^".*"$/)                                   return json_str(unescape_go(substr(s, 2, length(s)-2)))
            if (s ~ /^\{/ || s ~ /^\[/)                         return s
            if (s ~ /^-?[0-9]+$/ || s ~ /^-?[0-9]*\.[0-9]+$/) return s
            if (s == "true" || s == "false" || s == "null")     return s
            return json_str(s)
        }

        {
            line = $0
            header = ""; klog_hdr = ""

            if (col_s > 0) {
                n_raw = split(line, _raw, " ")
                header = ""; payload = ""
                for (i = 1; i <= n_raw; i++) {
                    if (i >= col_s && i <= col_e) header  = (header  == "") ? _raw[i] : header  " " _raw[i]
                    else                          payload = (payload == "") ? _raw[i] : payload " " _raw[i]
                }
                line = payload

            } else if (match(line, /^\[[^]]*\]/)) {
                header = substr(line, RSTART, RLENGTH)
                line   = substr(line, RSTART + RLENGTH)

            } else if (match(line, /^[A-Z][a-z][a-z] [ 0-9][0-9] [0-9][0-9]:[0-9][0-9]:[0-9][0-9] [^ ]+ [^ ]+: /)) {
                header = substr(line, RSTART, RLENGTH); sub(/ $/, "", header)
                line   = substr(line, RSTART + RLENGTH)

            } else if (match(line, /^[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9] [0-9][0-9]:[0-9][0-9]:[0-9][0-9]/)) {
                header = substr(line, RSTART, RLENGTH)
                rest   = substr(line, RSTART + RLENGTH)
                if (match(rest, /^ [A-Z][A-Z]+( |$)/)) {
                    level = substr(rest, RSTART, RLENGTH); sub(/ $/, "", level)
                    header = header level; rest = substr(rest, RSTART + RLENGTH)
                }
                line = rest

            } else if (match(line, /^[^ ]+ [^ ]+ [^ ]+: /)) {
                header = substr(line, RSTART, RLENGTH); sub(/ $/, "", header)
                line   = substr(line, RSTART + RLENGTH)
            }

            if (match(line, /^[IWEF][0-9][0-9][0-9][0-9] [0-9][0-9]:[0-9][0-9]:[0-9][0-9]\.[0-9]+ +[0-9]+ [^ ]+\] /)) {
                klog_hdr = substr(line, RSTART, RLENGTH); sub(/ $/, "", klog_hdr)
                line     = substr(line, RSTART + RLENGTH)
            }

            n = tokenize(line)

            if (json_mode) {
                delete fkeys; delete fvals; nf = 0
                delete _tarr; nt = 0
                if (header   != "") { fkeys[++nf] = "_time"; fvals[nf] = json_str(header)   }
                if (klog_hdr != "") { fkeys[++nf] = "_klog";    fvals[nf] = json_str(klog_hdr) }

                first = 1
                for (i = 1; i <= n; i++) {
                    tok = _tok[i]
                    if (index(tok, "=") > 0) {
                        eq = index(tok, "=")
                        fkeys[++nf] = substr(tok, 1, eq-1)
                        fvals[nf]   = json_val(substr(tok, eq+1))
                        first = 0
                    } else if (first && substr(tok, 1, 1) == "\"") {
                        fkeys[++nf] = "_message"
                        inner = unescape_go(substr(tok, 2, length(tok)-2))
                        fvals[nf] = (length(inner) > 60) ? wordwrap(inner, 60) : json_str(inner)
                        first = 0
                    } else {
                        _tarr[++nt] = tok
                        first = 0
                    }
                }
                if (nt == 1) {
                    fkeys[++nf] = "_text"
                    inner = _tarr[1]
                    if (substr(inner, 1, 1) == "\"")
                        inner = unescape_go(substr(inner, 2, length(inner)-2))
                    fvals[nf] = (length(inner) > 60) ? wordwrap(inner, 60) : json_str(inner)
                } else if (nt > 1) {
                    joined = _tarr[1]
                    for (i = 2; i <= nt; i++) joined = joined " " _tarr[i]
                    fkeys[++nf] = "_text"
                    fvals[nf] = (length(joined) > 60) ? wordwrap(joined, 60) : json_str(joined)
                }

                printf "{"
                for (i = 1; i <= nf; i++)
                    printf "%s%s:%s", (i > 1 ? "," : ""), json_str(fkeys[i]), fvals[i]
                printf "}\n"

            } else {
                if (header   != "") print header
                if (klog_hdr != "") print indent klog_hdr

                group = ""
                for (i = 1; i <= n; i++) {
                    tok = _tok[i]
                    if (index(tok, "=") > 0) {
                        if (group != "") {
                            if (substr(group, 1, 1) == "\"") {
                                print indent group
                                print indent tok
                            } else {
                                print indent group " " tok
                            }
                            group = ""
                        } else {
                            print indent tok
                        }
                    } else {
                        group = (group == "") ? tok : group " " tok
                    }
                }
                if (group != "") print indent group
                if (sep) print ""
            }
        }
        '
    }

    _syslog_pretty_json() {
        local line trimmed key jval fmt
        local -a jlines

        while IFS= read -r line; do
            if [[ "$line" == "${indent}"* && "$line" != "${indent}${indent}"* ]]; then
                trimmed="${line#$indent}"
                if [[ "$trimmed" =~ ^([^=]+)=([\{\[].+)$ ]]; then
                    key="${BASH_REMATCH[1]}"
                    jval="${BASH_REMATCH[2]}"
                    fmt=$(printf '%s' "$jval" | _jsonfmt 2>/dev/null)
                    if [[ $? -eq 0 && "$fmt" == *$'\n'* ]]; then
                        readarray -t jlines <<< "$fmt"
                        local total=${#jlines[@]} j
                        for (( j=0; j<total; j++ )); do
                            if   [[ $j -eq 0 ]];            then
                                printf '%s%s=%s\n' "$indent" "$key" "${jlines[$j]}"
                            else
                                printf '%s%s\n'    "$indent" "${jlines[$j]}"
                            fi
                        done
                        continue
                    fi
                fi
            fi
            printf '%s\n' "$line"
        done
    }

    if [[ $json_mode -eq 1 ]]
        then
            if [[ $# -gt 0 ]];
                then echo "$*" | _syslog_pretty_awk | _jsonfmt_jsonl
            else
                _syslog_pretty_awk | _jsonfmt_jsonl
            fi
        else
            if [[ $# -gt 0 ]]; then
                echo "$*" | _syslog_pretty_awk | _syslog_pretty_json
            else
                _syslog_pretty_awk | _syslog_pretty_json
            fi
    fi
}

log_by_time() {
# Filter log lines around a reference timestamp (like grep -C/-A/-B by time)
# Usage: log_by_time [--hour N] [--minute N] [--second N] [--day N] TIMESTAMP [FILE...]
# N: ±both  +N: after only  -N: before only.  Default: --minute 5
# Example: log_by_time --hour +1 "2025-11-28T14:17:42.789+03:00" /var/log/app.log
# Example: grep -m1 ERROR app.log | log_by_time --hour 1 app.log

    local ref_time="" before_secs=300 after_secs=300
    local col_start="none" delimiter=" "
    local input_files=() verbose=false
    local help_text
    help_text=$(cat <<'EOF'
log_by_time — filter log lines around a reference timestamp

USAGE
  log_by_time [OPTIONS] TIMESTAMP [FILE...]

TIME OPTIONS  (N = ±both   +N = after only   -N = before only;  default: --minute 5)
  --second, --sec, -s N     window in N seconds
  --minute, --min, -m N     window in N minutes
  --hour, -h          N     window in N hours
  --day, -d           N     window in N days
  --time              VAL   compact form: 1h / +30m / -2d

OTHER
  --col-start SPEC  column(s) to search for timestamp (default: search entire line)
                    single: 1   range: 1-3   list: 1,2,3
  --delimiter CHAR  field delimiter for --col-start (default: space)
  --verbose         print debug info to stderr
  --help            this help

SUPPORTED FORMATS (auto-detected in both TIMESTAMP arg and FILE lines)
  2025-11-28T14:17:42.789+03:00   ISO 8601 + ms + TZ
  2025-11-28T14:17:42Z            ISO 8601 UTC
  2025-11-28 14:17:42             plain datetime
  28/Nov/2025:14:17:42 +0300      nginx / Apache combined
  Nov 28 14:17:42                 syslog (BSD / RFC 3164)

EXAMPLES
  log_by_time --hour 1  "2025-11-28T14:17:42.789+03:00"  /var/log/app.log
  log_by_time --hour +1 "2025-11-28T14:17:42+03:00"      /var/log/app.log
  log_by_time --minute -30 "Nov 28 14:17:42"             /var/log/syslog
  log_by_time --time +2h "2025-11-28T14:17:42Z"          /var/log/k3s.log
  grep -m1 ERROR app.log | log_by_time --hour 1 app.log
  log_by_time --minute 10 --col-start 1 "2025-11-28T14:17:42Z" /var/log/k3s.log
  log_by_time --minute 10 --col-start 1-3 "Nov 28 14:17:42"    /var/log/syslog
EOF
)

    _lbt_err() { echo "[log_by_time] $*" >&2; }
    _lbt_dbg() { [[ $verbose == true ]] && echo "[log_by_time:dbg] $*" >&2; }
    
    # val mult → sets before_secs / after_secs
    _lbt_window() {          
        local val="$1" mult="$2" n secs
        n="${val#[+-]}"
        [[ "$n" =~ ^[0-9]+$ ]] || { _lbt_err "invalid value: $val"; return 1; }
        secs=$(( n * mult ))

        if   [[ "$val" == -* ]]; then 
            before_secs=$secs
            after_secs=0
        elif [[ "$val" == +* ]]; then 
            before_secs=0
            after_secs=$secs
        else
            before_secs=$secs
            after_secs=$secs
        fi
    }

    # "1h" / "+30m" / "-2d"
    _lbt_parse_time() {
        local val="$1"
        [[ "$val" =~ ^([+-]?)([0-9]+)([smhd])$ ]] \
            || { _lbt_err "invalid --time: $val  (expected [+|-]Ns|m|h|d)"; return 1; }
        local sign="${BASH_REMATCH[1]}" num="${BASH_REMATCH[2]}" unit="${BASH_REMATCH[3]}" mult
        case "$unit" in s) mult=1;; m) mult=60;; h) mult=3600;; d) mult=86400;; esac
        _lbt_window "${sign}${num}" "$mult"
    }

    _lbt_to_epoch() {
        local s="$1" e ts
        s="${s//[}" ; s="${s//]}"
        e=$(date -d "$s" +%s 2>/dev/null) && { echo "$e"; return 0; }
        if [[ "$s" =~ ^([0-9]{1,2})/([A-Za-z]{3})/([0-9]{4}):([0-9:]{8})(.*) ]]; then
            e=$(date -d "${BASH_REMATCH[1]} ${BASH_REMATCH[2]} ${BASH_REMATCH[3]} ${BASH_REMATCH[4]}${BASH_REMATCH[5]}" \
                    +%s 2>/dev/null) && { echo "$e"; return 0; }
        fi
        ts=$(grep -oP \
            '[0-9]{4}-[0-9]{2}-[0-9]{2}[T ][0-9]{2}:[0-9]{2}:[0-9]{2}(\.[0-9]+)?([+-][0-9]{2}:?[0-9]{2}|Z)?' \
            <<< "$s" | head -1)
        [[ -n "$ts" ]] && e=$(date -d "$ts" +%s 2>/dev/null) && { echo "$e"; return 0; }
        ts=$(grep -oP '[0-9]{1,2}/[A-Za-z]{3}/[0-9]{4}:[0-9]{2}:[0-9]{2}:[0-9]{2}( [+-][0-9]{4})?' \
            <<< "$s" | head -1)
        if [[ -n "$ts" ]] && [[ "$ts" =~ ([0-9]{1,2})/([A-Za-z]{3})/([0-9]{4}):([0-9:]{8})(.*) ]]; then
            e=$(date -d "${BASH_REMATCH[1]} ${BASH_REMATCH[2]} ${BASH_REMATCH[3]} ${BASH_REMATCH[4]}${BASH_REMATCH[5]}" \
                    +%s 2>/dev/null) && { echo "$e"; return 0; }
        fi
        ts=$(grep -oP '[A-Z][a-z]{2}\s+[0-9]{1,2}\s+[0-9]{2}:[0-9]{2}:[0-9]{2}' <<< "$s" | head -1)
        [[ -n "$ts" ]] && e=$(date -d "$ts" +%s 2>/dev/null) && { echo "$e"; return 0; }
        return 1
    }

    while [[ $# -gt 0 ]]; do
        case "$1" in
            -h|--help|help)    echo "$help_text"; return 0 ;;
            --second|--sec|-s) _lbt_window "$2" 1     || return 1; shift ;;
            --minute|--min|-m) _lbt_window "$2" 60    || return 1; shift ;;
            --hour|-h)         _lbt_window "$2" 3600  || return 1; shift ;;
            --day|-d)          _lbt_window "$2" 86400 || return 1; shift ;;
            --time=*)          _lbt_parse_time "${1#*=}" || return 1 ;;
            --time)            _lbt_parse_time "$2"   || return 1; shift ;;
            --col-start=*)     col_start="${1#*=}" ;;
            --col-start)       col_start="$2"; shift ;;
            --delimiter=*)     delimiter="${1#*=}" ;;
            --delimiter)       delimiter="$2"; shift ;;
            --verbose)         verbose=true ;;
            --*)               _lbt_err "unknown option: $1"; return 1 ;;
            *)
                if [[ -z "$ref_time" ]]; then ref_time="$1"
                else input_files+=("$1")
                fi ;;
        esac
        shift
    done

    [[ -z "$ref_time" ]] && { _lbt_err "reference timestamp required (--help for usage)"; return 1; }
    [[ ${#input_files[@]} -eq 0 && -t 0 ]] && { _lbt_err "no input files and stdin is a terminal"; return 1; }
    [[ ${#input_files[@]} -eq 0 ]] && input_files=("-")

    local ref_epoch
    ref_epoch=$(_lbt_to_epoch "$ref_time") || { _lbt_err "cannot parse timestamp: '$ref_time'"; return 1; }

    local start_epoch=$(( ref_epoch - before_secs ))
    local end_epoch=$(( ref_epoch   + after_secs  ))

    _lbt_dbg "ref_epoch=$ref_epoch  before=${before_secs}s  after=${after_secs}s"
    _lbt_dbg "window: $(date -d "@$start_epoch" '+%F %T') .. $(date -d "@$end_epoch" '+%F %T')"

    local awk_script
    _lbt_dbg "col_start=$col_start  delimiter='$delimiter'"

    awk \
        -v "start_epoch=$start_epoch" \
        -v "end_epoch=$end_epoch"     \
        -v "col_start=$col_start"     \
        -v "delimiter=$delimiter"     \
        '
        BEGIN {
            FS = delimiter
            if (col_start != "none") {
                n = split(col_start, parts, ",")
                for (i = 1; i <= n; i++) {
                    if (parts[i] ~ /^[0-9]+-[0-9]+$/) {
                        split(parts[i], rng, "-")
                        for (j = rng[1]+0; j <= rng[2]+0; j++)
                            col_indices[++col_count] = j
                    } else {
                        col_indices[++col_count] = parts[i]+0
                    }
                }
            }
        }

        function find_ts(text) {
            if (match(text, /[0-9]{4}-[0-9]{2}-[0-9]{2}[T ][0-9]{2}:[0-9]{2}:[0-9]{2}(\.[0-9]+)?([+-][0-9][0-9]:?[0-9][0-9]|Z)?/))
                return substr(text, RSTART, RLENGTH)
            if (match(text, /[0-9]{1,2}\/[A-Za-z]{3}\/[0-9]{4}:[0-9]{2}:[0-9]{2}:[0-9]{2}( [+-][0-9]{4})?/))
                return substr(text, RSTART, RLENGTH)
            if (match(text, /[A-Z][a-z]{2} [ 0-9][0-9] [0-9]{2}:[0-9]{2}:[0-9]{2}/))
                return substr(text, RSTART, RLENGTH)
            return ""
        }

        function ts_to_epoch(ts,    cmd, epoch, key, ts_n) {
            key = ts; sub(/\.[0-9]+/, "", key)
            if (key in cache) return cache[key]
            ts_n = ts
            if (ts_n ~ /^[0-9]+\/[A-Za-z]+\/[0-9]+:/) {
                gsub(/\//, " ", ts_n)
                sub(/:/, " ", ts_n)
            }
            cmd = "date -d \"" ts_n "\" +%s 2>/dev/null"
            epoch = ""; cmd | getline epoch; close(cmd)
            cache[key] = (epoch ~ /^[0-9]+$/) ? epoch + 0 : -1
            return cache[key]
        }

        {
            if (col_start == "none") {
                search = $0
            } else {
                search = ""
                for (i = 1; i <= col_count; i++) {
                    c = col_indices[i]
                    if (c > 0 && c <= NF)
                        search = (search == "") ? $c : search " " $c
                }
                if (search == "") search = $0
            }
            ts = find_ts(search)
            if (ts == "") next
            e = ts_to_epoch(ts)
            if (e < 0 || e < start_epoch || e > end_epoch) next
            print
        }
        ' "${input_files[@]}"
}


