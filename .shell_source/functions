function docker_log() {
#docker inspect log output
    local container="${1:-}"
    local sudo_used=''
    local output_format="json"
    local interval="1s"
    local result=''
    local part_line=''    

    if [[ -z "$container" ]] || [[ "$container" =~ ^-- ]]; then        
        echo "Usage: docker_log <conatainer> --since=[since]"
        echo "Example: dcoker_log nginx1"
        return 1
    fi
    shift

    if [[ $EUID -ne 0 ]]; then
        if $(sudo -v);
            then sudo_used='sudo'
        fi
    fi

    while [[ "$#" -gt 0 ]]; do
        case $1 in
            --since=*) interval="${1#*=}" ;;
            --since)
                interval="${2:-${interval}}"; shift ;;
            --format=*) output_format="${1#*=}" ;;
            --format)
                output_format="${2:-${output_format}}"; shift ;;
            *)
                #ignore
                ;;
        esac
        shift
    done

    if [ -n $(whereis docker |cut -d: -f2 |egrep '/bin|/sbin' |tr -d ' ') ]; then
        if [ -n $(whereis jq |cut -d: -f2 |egrep '/bin|/sbin' |tr -d ' ') ]; then

            ${sudo_used} docker inspect "$container" \
            | jq -r '.[0].State.Health.Log[].Output'

            local grep_time=$(echo $interval |grep -o '[a-zA-Z]')
            local grep_num=$(echo $interval |grep -o '[0-9]\+')
            if [ -n "$grep_num" ]; then
                if [ -z "$grep_time" ]; then interval="${interval}s"; fi
            else
                echo "Value in parameter not found"
                return 1
            fi

            echo -e "==================== LOGS for ${1} =====================: \n\n"
            while true; do
                part_line="$(
                    printf '\n'; printf '%.0s-' {1..30}; \
                    printf '  %s  ' "$(date '+%A %B %d   %H:%M:%S %Y %Z')"; \
                    printf '%.0s-' {1..30}; printf '\n'
                )"

                if [[ "$output_format" =~ ^json ]] && command -v jq &>/dev/null
                    then
                        result=$(
                            ${sudo_used} docker logs --details "$container" \
                                --since "$interval" 2>&1 |jq
                        )
                    else
                        result=$(
                            ${sudo_used} docker logs --details "$container" \
                                --since "$interval" 2>&1 |sed 's/$/\r\n/g'
                        )
                fi

                if [ -n "$result" ]; then
                    echo -e "\033[0;33m $part_line \033[0m"
                    echo -e "$result\n"
                fi

                sleep $interval
            done
        fi
    fi
}

docker_exec() {
#docker exec to container
    if [ -n $(whereis docker |cut -d: -f2 |egrep '/bin|/sbin' |tr -d ' ') ]; then
        if [ -n $(whereis jq |cut -d: -f2 |egrep '/bin|/sbin' |tr -d ' ') ]; then

            local sudo_used=''
            if $(sudo -v); then sudo_used='sudo'; fi

            if ! ${sudo_used} docker exec $1 test -f /tmp/.bashrc 2>/dev/null; then
                ${sudo_used} docker cp ${HOME}/.config/bashrc_docker $1:/root/.bashrc 2>/dev/null
                ${sudo_used} docker cp ${HOME}/.config/bashrc_docker $1:/tmp/.bashrc 2>/dev/null
            fi                

            ${sudo_used} docker exec -it $1 zsh  || \
            ${sudo_used} docker exec -it $1 bash || \
            ${sudo_used} docker exec -it $1 ash  || \
            ${sudo_used} docker exec -it $1 sh
        fi
    fi

}

cat_z () {
    local path_logs="${2:-.}"
    local pattern="$1"
    local sudo_used=''
    local type_log=''

    if [[ $EUID -ne 0 ]]; then
        if $(sudo -v);
            then sudo_used='sudo'
        fi
    fi

    ${sudo_used} find "$path_logs" -type f -name "$pattern" -print0 |while IFS= read -r -d $'\0' log_file; do
        type_log="$( ${sudo_used} file $log_file |cut -d ':' -f2 |cut -d ',' -f1)"

        case "$type_log" in
            *ASCII*) archive_cat="cat" ;;
            *gzip*)  archive_cat="zcat" ;;
            *XZ*)    archive_cat="xzcat" ;;
            *bzip2*) archive_cat="bzcat" ;;
            *lzip*)  archive_cat="lzcat" ;;
            *)       archive_cat="cat" ;;
        esac

        ${sudo_used} ${archive_cat} "$log_file"
    done
}

