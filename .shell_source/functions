jobs() {
# Example: jobss
    declare -A job_pids
    declare -A job_markers   # -> marker ('+', '-' or '')
    declare -A job_commands
    
    local jobs_output
    jobs_output=$(builtin jobs -l)
    
    if [[ -z "$jobs_output" ]]; then
        return 1
    fi
    
    while IFS= read -r line; do
        if [[ $line =~ ^\[([0-9]+)\]([+-]?)\ +([0-9]+) ]]; then
            local job_num="${BASH_REMATCH[1]}"
            local marker="${BASH_REMATCH[2]}"
            local pid="${BASH_REMATCH[3]}"
            
            job_pids[$job_num]=$pid
            job_markers[$job_num]=$marker
        fi
    done <<< "$jobs_output"
    
    # Get command
    for job_num in "${!job_pids[@]}"; do
        local pid="${job_pids[$job_num]}"
        local full_command
        full_command=$(ps -p "$pid" -o cmd= 2>/dev/null)
        
        if [[ -z "$full_command" ]]; then
            full_command="<NOT FOUND>"
        else
            full_command=$(echo "$full_command" | sed -E 's|^/usr/bin/sudo ([A-Z_]+=\S+ )*|sudo |')
        fi
        job_commands[$job_num]=$full_command
    done
    
    # result in associative
    for job_num in $(echo "${!job_pids[@]}" | tr ' ' '\n' | sort -n); do
        local marker="${job_markers[$job_num]}"
        local pid="${job_pids[$job_num]}"
        local command="${job_commands[$job_num]}"
        printf "[%d]%s %d\t\t%s\n" "$job_num" "$marker" "$pid" "$command"
    done
}

fg() {
# Resume a job by number or partial name: fg, fg 1, fg %1, fg vim ...
    local arg="${1:-}"

    # no arg → resume current (+) job
    [[ -z "$arg" ]] && { builtin fg; return; }

    # numeric (1, %1) → pass straight to builtin
    [[ "$arg" =~ ^%?[0-9]+$ ]] && { builtin fg "$arg"; return; }

    # partial name search: scan jobs via ps
    local jobs_raw job_num pid marker best_num=-1
    jobs_raw=$(builtin jobs -l)
    [[ -z "$jobs_raw" ]] && { echo "fg: no jobs" >&2; return 1; }

    while IFS= read -r line; do
        [[ "$line" =~ ^\[([0-9]+)\]([+-]?)[[:space:]]+([0-9]+) ]] || continue
        job_num="${BASH_REMATCH[1]}"
        pid="${BASH_REMATCH[3]}"
        local cmd
        cmd=$(ps -p "$pid" -o cmd= 2>/dev/null)
        if [[ "$cmd" == *"$arg"* ]]; then
            (( best_num < 0 || job_num < best_num )) && best_num=$job_num
        fi
    done <<< "$jobs_raw"

    if (( best_num < 0 )); then
        echo "fg: no job matching '$arg'" >&2
        return 1
    fi
    builtin fg "%$best_num"
}

renull() {
# clean file     
    if [ -z "$1" ]; then
        echo "Error: file not specified" >&2
        echo "Usage: renull </path/to/file>" >&2
        return 1
    fi
    
    if [ ! -f "$1" ]; then
        echo "Error: file '$1' does not exist" >&2
        return 1
    fi
    
    if [ ! -w "$1" ]; then
        echo "Error: no write permission for file '$1'" >&2
        return 1
    fi
    
    cat /dev/null > "$1"
    echo "File '$1' successfully clean"
}

pbcopy() {
# copy to clipboard buffer    
    local xsel_exist=false
    local xclip_exist=false

    local path_xsel=$(type -P xsel)
    if [[ $? == 0 ]]; then
        xsel_exist=true
    fi

    local path_xclip=$(type -P xclip)
    if [[ $? == 0 ]]; then
        xclip_exist=true
    fi
    
    if $check_xsel; then
        cat "$1" |$path_xsel --clipboard --input
    elif $check_xclip; then
        cat "$1" |$path_xclip -selection clipboard
    else
        echo -e "xsel or xclip not found, please install this before use it \n"
    fi            
}

