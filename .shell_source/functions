allcrontab() {
    local red='\e[0;31m'
    local RED='\e[1;31m'
    local green='\e[0;32m'
    local GREEN='\e[1;32m'
    local PURPLE='\e[1;35m'
    local YELLOW='\e[22;33m'
    local NC='\e[0m'

    local cron_dir="$(find /etc -type d -name "*cron*" 2> /dev/null)"

    for dir in $cron_dir; do
        echo -e "----------------- ${PURPLE}START ${dir} -------------------- ${NC}\n"
            for crond in $(ls -L1 $dir); do
                if $(sudo -v)
                    then crondtab=$(sudo sh -c "cat ${dir}/${crond} 2>/dev/null" |egrep -Ev "^\s*(;|#|$)")
                    else crondtab=$(cat "${dir}/${crond}" 2>/dev/null |egrep -Ev "^\s*(;|#|$)")
                fi

                if [ -n "${crondtab}" ]; then
                    echo -e "${RED}====== Start ${dir}/ ${NC}${GREEN}${crond}${NC} ${RED}======${NC}"
                        echo "${crondtab}"
                    echo -e "${RED}====== End ${crond} ${NC}${GREEN}${crond}${NC} ${RED}======${NC}\n"
                fi
            done
        echo -e "----------------- ${PURPLE}END ${dir} -------------------- ${NC}\n"
    done

    echo -e "----------------- ${PURPLE}START /etc/crontab -------------------- ${NC}\n"
        cat /etc/crontab |egrep -Ev "^\s*(;|#|$)"
    echo -e "----------------- ${PURPLE}END /etc/crontab -------------------- ${NC}\n"

    echo -e "----------------- ${PURPLE}START users crontab -------------------- ${NC}\n"
        if $(sudo -v &> /dev/null); then
            for user in $(cut -d':' -f1 /etc/passwd); do
                local usercrontab=$(sudo sh -c "crontab -l -u ${user} 2>/dev/null")

                if [ -n "${usercrontab}" ]; then
                    echo -e "${RED}====== Start crontab for user ${NC}${GREEN}${user}${NC} ${RED}======${NC}"
                        sudo sh -c "crontab -l -u ${user}" |sed '/ *#/d; /^ *$/d'
                    echo -e "${RED}====== End crontab for user ${NC}${GREEN}${user}${NC} ${RED}========${NC}\n"
                fi
            done
        else
            echo -e "${YELLOW}====== Start crontab for user ${NC}${GREEN}${user}${NC} ${YELLOW}======${NC}"
                crontab -l |sed '/ *#/d; /^ *$/d'
            echo -e "${YELLOW}====== End crontab for user ${NC}${GREEN}${user}${NC} ${YELLOW}========${NC}\n"
        fi
    echo -e "----------------- ${PURPLE}END users crontab -------------------- ${NC}\n"

}


checkSizeInDirWithIgnore() {
#C- example: checkSizeInDirWithIgnore var boot
#or         checkSizeInDirWithIgnore
    local params=''
    local with=false
    if [ "$1" = '--with-proc' ]
        then with=true
        else params="-I proc -I sys -I dev"
    fi

    if [ "$#" -lt 1 ]
        then params="$params -I mnt "
        elif [ "$#" -gt 1 ]; then

            if [ "$with" = true ]
                then item_no=2
                else item_no=1
            fi

            local count="$#"
            for ((i=$item_no; i <= $count; i++)); do
                param="${!i}"
                params="$params -I $param "
            done
        else params+=" -I $1"
    fi

    local list="$(ls -a $params |egrep -v '^(\.\.|\.)$')"
    if $(sudo -v); then
        echo -e "this directory - \033[1;36m $(pwd) \033[0m"
        sudo du -sh $list |sort -hr; else
        du -sh $list      |sort -hr
    fi
}

removeComments() {
# Used: removeComments /path/to/file [removed_char] [--implode] [--multiline='START END']
# or    removeComments /path/to/file --implode
# TODO ADD EXCLUDE SPECIFIC
    local run=false
    local removed='#'
    local implode=false
    local path=''
    local cmd=('egrep')
    local sudo_used=''
    # нужен чтобы '#' не съедался внутри двойных кавычек sed
    local marker="$(printf '%s' "${removed}PATTERN_DEL")"
    local tail_cmd=('cat' '-s')
    local -a multiline_starts=()
    local -a multiline_ends=()    
    local help_text

        help_text=$(cat <<'EOF'
removeComments - remove typical useless comments

USAGE:
        removeComments <file> [removed_char] [--implode]

ARGUMENTS:
  <file>          path to file

OPTIONS:
  [removed_char]  comment character (default: #)
  --implode       remove all empty lines (default: squeeze multiple into one)

EXAMPLES:
  removeComments /etc/ssh/sshd_config

  # And remove empty strings
  removeComments /etc/ssh/sshd_config --implode

  # Remove comments with specific char, on example ;
  removeComments /path/to/file '\;'

  # Remove C-style multi-line comments
  removeComments /path/to/file.c --multiline='/* */'

  # Remove Python-style multiple multiline patterns at once
  removeComments file.py --multiline='""" """' --multiline="''' '''"  
EOF
)

    for arg in "$@"; do
        case "$arg" in
            --implode) implode=true ;;
            -h|--help|help) echo "$help_text"; return ;;
            --multiline=*)
                local _ml="${arg#--multiline=}"
                [[ "$_ml" == \"*\" || "$_ml" == \'*\' ]] && _ml="${_ml:1:${#_ml}-2}"
                multiline_starts+=("${_ml%% *}")
                multiline_ends+=("${_ml##* }")
                ;;            
            *)
                [ -z "$path" ] && path="$arg" || removed="$arg" ;;
        esac
    done

    if [ -z "$path" ]; then
        echo -e "Error: no arguments, must will be min - 1"
    else
        run=true
    fi

    if [ "$run" = true ]; then
        if [[ $EUID -ne 0 ]]; then
            if $(sudo -v); then
                cmd=('sudo' 'egrep')
                sudo_used='sudo'
            fi
        fi

        if [ "$implode" = true ]; then
            tail_cmd=('grep' '-v' '^$')
        fi

        if [[ ${#multiline_starts[@]} -gt 0 ]]; then
            local i ms_esc me_esc
            # build sed script: for each pattern — first strip inline, then block
            local ml_script=''
            for (( i=0; i<${#multiline_starts[@]}; i++ )); do
                ms_esc="${multiline_starts[i]//\//\\/}"
                ms_esc="${ms_esc//\*/\\*}"
                me_esc="${multiline_ends[i]//\//\\/}"
                me_esc="${me_esc//\*/\\*}"
                ml_script+="s/${ms_esc}.*${me_esc}//g;"$'\n'
                ml_script+="/${ms_esc}/,/${me_esc}/d;"$'\n'
            done
            ${sudo_used} sed "$ml_script" "$path" \
                |egrep -v "^\s*${removed}" \
                |sed "s| ${removed} .*| ${marker}|g" \
                |sed 's/^\s*$//' |"${tail_cmd[@]}"
        else
            "${cmd[@]}" -v "^\s*${removed}" "$path" \
                |sed "s| ${removed} .*| ${marker}|g" \
                |sed 's/^\s*$//' |"${tail_cmd[@]}"
        fi

    fi
}

egreplessdir() {
#C- Example: egreplessdir  'string' /path/to/dir '\comment_prefix' '--binary' '--exclude=dir1:dir2' 
#or          egreplessdir  'pattern' /path --exclude=.git:node_modules
    local run=false
    local comment='#'
    local path="$2"
    local pattern="$1"
    local param=''
    local exclude_dirs=()
    local grep_excludes=()
    local exclude='tmp_d313d4379asgdgs'
    local grep_flags="-iIr"
    local arr_old_args=("$@")
    local arr_new_args=()

    for arg in "${arr_old_args[@]}"; do
        if [[ "$arg" == --exclude=* ]]; then
            IFS=':' read -ra dirs <<< "${arg#*=}"
            exclude_dirs+=("${dirs[@]}")
        else
            arr_new_args+=("$arg")
        fi
    done

        # rewrite parametes (remove parameters exclude)
    set -- "${arr_new_args[@]}"
    pattern="$1"
    path="$2"
    
    if [ "$#" -lt 2 ]; then
       echo -e "Error: too few arguments, must be min - 2"
    elif [ "$#" -gt 4 ]; then
       echo -e "Error: too many arguments, must be max - 4 (including --exclude='dir1:dir2')"
    else
        run=true
        if [ "$#" -ge 3 ]; then
            if [ -n "$3" ] && [ "$3" != " " ]; then
                comment="$3"
            fi
        fi

        if [ "$#" -eq 4 ]; then
            param="$4"
        fi
    fi

    if [ "$run" = true ]; then
        if [ "$param" = '--binary' ]; then  grep_flags="-iar" ; fi
        for dir in "${exclude_dirs[@]}"; do
                #add element to array
            grep_excludes+=(--exclude-dir="$dir")
        done

        grep "${grep_excludes[@]}" -o ".\{0,120\}${pattern}.\{0,120\}" $grep_flags "$path" |\
        egrep -v "^${comment}|^\s?+${comment}" | \
        sed "s/\(:${comment}\).*/ -_CLEARED_by_filter_-/g" | \
        grep -i "$pattern"
    fi
}

egrepless() {
# Usage: egrepless 'pattern' /path/to/file [comment_char] [--no-num]
# Examples: egrepless  'struing' /path/to/file '\string_comment'
#           egrepless  'string pattern' /path/to/file
#           cat file | egrepless 'pattern' '\comment'
    local comment='#'
    local comment='#'
    local pattern=''
    local path=''
    local no_num=false
    local piped=false
    local help_text
    help_text=$(cat <<'EOF'
egrepless — grep with context window, comment filtering, and line numbers

USAGE
  egrepless 'pattern' /path/to/file [comment_char] [--no-num]
  cat file | egrepless 'pattern' [comment_char] [--no-num]

ARGS
  pattern       search string (case-insensitive)
  file          file to search (not needed when piping)
  comment_char  strip inline comments starting with this char (default: #)
  --no-num      hide line numbers
  --help, -h    this help

EXAMPLES
  egrepless 'error' /var/log/syslog
  egrepless 'error' /var/log/syslog '\#'
  cat /etc/protocols | egrepless 'udp'
  cat /etc/protocols | egrepless 'udp' '\#'
  cat /etc/protocols | egrepless 'udp' '\#' --no-num
EOF
)

    if [ "$1" = '--help' ] || [ "$1" = '-h' ]; then
        echo "$help_text"; return 0
    fi

    if [ -p /dev/stdin ]; then
        piped=true
        path='/dev/stdin'
    fi

    if [ "$piped" = true ]; then
        if [ "$#" -lt 1 ]; then
            echo "Error: pattern required"; return 1
        fi
        pattern="$1"
        for arg in "${@:2}"; do
            if [ "$arg" = '--no-num' ]; then no_num=true
            elif [ -n "$arg" ] && [ "$arg" != ' ' ]; then comment="$arg"
            fi
        done
    else
        if [ "$#" -lt 2 ]; then
            echo "Error: pattern and file required"; return 1
        fi
        pattern="$1"
        path="$2"
        for arg in "${@:3}"; do
            if [ "$arg" = '--no-num' ]; then no_num=true
            elif [ -n "$arg" ] && [ "$arg" != ' ' ]; then comment="$arg"
            fi
        done
    fi

    if [ "$no_num" = true ]; then
        grep -o ".\{0,150\}${pattern}.\{0,150\}" -i "$path" \
            |egrep -v "^\s*${comment}" \
            |sed "s/\(\s\+\|:\)${comment}.*/ -_CLEARED_by_filter_-/g" \
            |grep -i "$pattern"
    else
        grep -on ".\{0,150\}${pattern}.\{0,150\}" -i "$path" \
            |egrep -v "^[0-9]*:\s*${comment}" \
            |sed "s/\(\s\+\|:\)${comment}.*/ -_CLEARED_by_filter_-/g" \
            |grep -i "$pattern"
    fi
}    
}


