    local xclip_exist=false
    local output_path="$1"

    local path_xsel=$(type -P xsel)
    if [[ $? == 0 ]]; then
        xsel_exist=true
    fi

    local path_xclip=$(type -P xclip)
    if [[ $? == 0 ]]; then
        xclip_exist=true
    fi
    
    if $check_xsel; then
        if [ -n "$output_path" ]
            then $path_xsel --clipboard --output >> $output_path
            else $path_xsel --clipboard --output
        fi
    elif $check_xclip; then
        if [ -n "$output_path" ]
            then $path_xclip -selection clipboard -o >> $output_path
            else $path_xclip -selection clipboard -o
        fi
    else
        echo -e "xsel or xclip not found, please install this before use it \n"
    fi            
}

