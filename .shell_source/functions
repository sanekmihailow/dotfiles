            --format)
                output_format="${2:-${output_format}}"; shift ;;
            *)
                #ignore
                ;;
        esac
        shift
    done

    local grep_time=$(echo $interval |grep -o '[a-zA-Z]')
    local grep_num=$(echo $interval |grep -o '[0-9]\+')
