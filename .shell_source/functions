show_changed_files() {
    local search_path='.'
    local start_exclude_path="-path /tmp/new_files"
    local exclude_paths=''
    local sudo_used=''
    local row_lenght=25
    local iso_format='long-iso'
    local nocolumn=false
    local column="eval column -t"
    local exclude=''
    local old_sort=false
    local sort_date="eval sort -nr"
    local create=false
    local DATE="$(date +%F)"
    local DATETIME="$(date +%F_%Hh-%Mm)"
    local out_path="/tmp/new_files/${DATE}"
    local echo_console=''
    local all_cli_args="$*"
    local date_from=''
    local date_to=''
    local from_epoch=0
    local to_epoch=0
    local date_filter='cat'
    local max_depth=''
    local depth_arg=''
    local help_text

    help_text=$(cat <<'EOF'
show_changed_files - Show recently changed files sorted by change time

USAGE:
    show_changed_files [PATH] [OPTIONS]

ARGUMENTS:
    PATH                Directory to search (default: current directory .)

OPTIONS:
    Output:
        --head=N        Limit output to N results (default: 25)
        --lenght=N      Alias for --head=N
        --nocolumn      Disable column alignment (use tab instead)
        --date-format=FMT  Date format for ls --time-style (default: long-iso)
                           Examples: long-iso, full-iso, iso, +%F\ %T

    Sorting:
        --old           Show oldest files first (default: newest first)

    Search Scope:
        --level=N       Limit directory depth (find -maxdepth N)
        --exclude=PATHS Space-separated list of paths to exclude

    Date Filter:
        --date-from=DATE  Show files changed on or after DATE
                          Format: "YYYY-MM-DD" or "YYYY-MM-DD HH:MM:SS"
                          Without --date-to: from DATE to now
        --date-to=DATE    Show files changed on or before DATE
                          Without --date-from: from beginning to DATE
                          Both together: exact date range

    Log:
        --create        Save output to /tmp/new_files/YYYY-MM-DD/

    Other:
        -h, --help      Show this help message

EXAMPLES:
    # Recently changed files in current dir
    show_changed_files

    # Search /etc, show 50 results
    show_changed_files /etc --head=50

    # Files changed since March 1st
    show_changed_files --date-from="2026-03-01"

    # Files changed in a specific range
    show_changed_files /var --date-from="2026-03-01" --date-to="2026-03-02 12:00"

    # Only top-level files, oldest first
    show_changed_files /etc --level=1 --old

    # Search and save to log
    show_changed_files /etc --create
EOF
)

    if [ -n "$1" ]; then
        if [[ "$1" != 'help' ]] \
        && [[ ! "$1" =~ ^-- ]] \
        && [[ "$1" != '-h' ]]
            then search_path="$1"
        fi
    fi

    if [[ $EUID -ne 0 ]]; then
        if $(sudo -v);
            then sudo_used='sudo'
        fi
    fi

    while [[ "$#" -gt 0 ]]; do
        case $1 in
            --head=[0-9]*) row_lenght="${1#*=}" ;;
            --lenght=[0-9]*) row_lenght="${1#*=}" ;;
            --nocolumn) nocolumn=true ;;
            --date-format=*) iso_format="${1#*=}" ;;
            --exclude=*) exclude="${1#*=}" ;;
            --old) old_sort=true ;;
            --create) create=true ;;
            --date-from=*) date_from="${1#*=}" ;;
            --date-to=*) date_to="${1#*=}" ;;
            --level=*) max_depth="${1#*=}" ;;
            -h|--help|help) echo "$help_text"; return ;;
            *)
                #ignore
                ;;
        esac
        shift #unset $1, and set new $1
    done

    if $nocolumn; then
        column="eval sed 's/ /\t/'"
    fi

        #exclude options
    if [ -n "$exclude" ]; then
        for i in ${exclude}; do
            echo $i
            exclude_paths="${exclude_paths} -o -path ${i}"
        done
    fi

        #show older on start
    if $old_sort; then
        sort_date="eval sort -n"
    fi

    if [ -n "$date_from" ]; then
        from_epoch=$(date -d "$date_from" +%s 2>/dev/null) \
            || { echo "show_changed_files: invalid --date-from: '$date_from'" >&2; return 1; }
    fi
    
    if [ -n "$date_to" ]; then
        to_epoch=$(date -d "$date_to" +%s 2>/dev/null) \
            || { echo "show_changed_files: invalid --date-to: '$date_to'" >&2; return 1; }
    fi

    if [ "$from_epoch" -ne 0 ] || [ "$to_epoch" -ne 0 ]; then
        date_filter="awk -v f=${from_epoch} -v t=${to_epoch} '(f==0||\$1>=f)&&(t==0||\$1<=t)'"
    fi    

    [ -n "$max_depth" ] && depth_arg="-maxdepth $max_depth"

    if $create; then
        if [ ! -d ${out_path} ]; then mkdir -p ${out_path}; fi
        check_tee=$(type -P tee)
        if [[ $? == 0 ]];
            then new_cat='tee -a'
            else new_cat='cat >> '
        fi
        echo -e "${all_cli_args} \n ${PWD} \n " >> ${out_path}/check_change_on_${DATETIME}
        command_output="$new_cat ${out_path}/check_change_on_${DATETIME}"
        echo_console="saved output in ${out_path}/check_change_on_${DATETIME}"
    else
        command_output="cat"
    fi

    ${sudo_used} find ${search_path} ${depth_arg} -type d  \( ${start_exclude_path} \
                    ${exclude_paths} \) -prune \
                    -o -type f -exec stat -c '%Z %n' {} \; \
    |eval "${date_filter}" \
    |${sort_date}  |head -n${row_lenght} |cut -d' ' -f2- \
    |${sudo_used} xargs -I{} ls -lhtc --time-style=${iso_format} -- {} \
    |${column} \
    |eval "$( echo ${command_output} )"
    echo -e "\n\033[0;32m ${echo_console} \033[0m"
}

addBackup() {
    local backup_path="${PWD}/${1}"
    local check_type="$(file -b ${backup_path})"
    local check_exist_chattr="$(type -P chattr)"
    sudo_used=''
    local num=0
    local check_num=0
    local check_zstd=''

    if [[ $EUID -ne 0 ]]; then
        if $(sudo -v);
            then sudo_used='sudo'
        fi
    fi

    if [ "$check_type" = "directory" ]
        then
            check_previous="$(2>/dev/null ls -a ${backup_path}_[0-9]* |egrep '\.(gz|zst)' 2> /dev/null)"
            if [ -n "$check_previous" ]; then
                check_num=$(echo "$check_previous" |wc -l)
            fi
            num=$(expr $check_num + 1)
            check_zstd="$(type -P zstd)"
            if [ -n "$check_zstd" ]
                then ${sudo_used} tar -I "zstd -12 -T0" -cf ${backup_path}_${num}.tar.zst ${backup_path}
                else ${sudo_used} tar czfp ${backup_path}_${num}.tar.gz ${backup_path}
            fi
        else
            check_previous="$(2>/dev/null ls -a ${backup_path}* |egrep '\.bak[0-9]+\.bak' 2> /dev/null)"
            if [ -n "$check_previous" ]; then
                check_num=$(echo "$check_previous" |wc -l)
            fi
            num=$(expr $check_num + 1)
            ${sudo_used} cp -a ${backup_path} ${backup_path}.bak${num}.bak

            if echo "$check_type" | grep -qi 'text\|script'; then
                local ext="${1##*.}"
                local comment_prefix='#'
                local comment_suffix=''

                case "${ext,,}" in
                    js|ts|java|c|cpp|cc|h|hpp|go|rs|swift|kt|cs|php)
                        comment_prefix='//' ;;
                    html|htm|xml|svg|xhtml)
                        comment_prefix='<!--'; comment_suffix=' -->' ;;
                    css|scss|less)
                        comment_prefix='/*'; comment_suffix=' */' ;;
                    sql|lua)
                        comment_prefix='--' ;;
                    tex|sty|cls)
                        comment_prefix='%' ;;
                esac

                local date_str="$(date '+%Y-%m-%d %H:%M:%S %Z')"
                local comment_line="${comment_prefix} Backup created: ${date_str}${comment_suffix}"
                local tmpfile="$(mktemp)"
                { echo "${comment_line}"; ${sudo_used} cat "${backup_path}.bak${num}.bak"; } > "${tmpfile}"
                ${sudo_used} mv "${tmpfile}" "${backup_path}.bak${num}.bak"
            fi

            ${sudo_used} chmod 0444 ${backup_path}.bak${num}.bak
            if [ -n "$check_exist_chattr" ]; then
                ${sudo_used} chattr +A ${backup_path}.bak${num}.bak
            fi
    fi
}

addVers() {
# save versioned copy of file to /tmp/versions/<cur_path>/<file>_versN
    if [ -z "$1" ]; then
        echo "Error: file not specified" >&2
        echo "Usage: addVers <file>" >&2
        return 1
    fi

    local filepath
    if [[ "$1" = /* ]]; then
        filepath="$1"
    else
        filepath="${PWD}/${1}"
    fi

    if [ ! -f "$filepath" ]; then
        echo "Error: file '$1' does not exist" >&2
        return 1
    fi

    local filename="$(basename "$filepath")"
    local dirpath="$(dirname "$filepath")"
    local vers_dir="/tmp/versions${dirpath}"
    local check_num=0
    local num=1

    mkdir -p "$vers_dir"
    local check_previous
    check_previous="$(ls "${vers_dir}/${filename}_vers"[0-9]* 2>/dev/null)"
    if [ -n "$check_previous" ]; then
        check_num=$(echo "$check_previous" | wc -l)
        num=$(expr $check_num + 1)
    fi

    local vers_path="${vers_dir}/${filename}_vers${num}"
    cp -a "$filepath" "$vers_path"
    echo "Saved: ${vers_path}"
}

