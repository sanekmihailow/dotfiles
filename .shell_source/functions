        then history |grep --color=always -i "$@" |grep -wvE "${hhgrepv}" |tail -n60 |colorex -b '^....[0-9]'
        else history |grep --color=always -i "$@" |grep -wvE "${hhgrepv}" |tail -n60 |grep '^....[0-9]'
