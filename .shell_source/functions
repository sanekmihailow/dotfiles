extract () {
#    
  if [ -z "$1" ]; then
    echo "Usage: extract <file>" >&2
    return 1
  fi

  if [ ! -f "$1" ]; then
      echo "'$1' is not a valid file!" >&2
      return 1
  fi

  case $1 in
      *.tar.bz2)   tar xvjf $1    ;;
      *.tar.gz)    tar xvzf $1    ;;
      *.tar.xz)   tar -xpJf $1    ;;
      *.bz2)       bunzip2 $1     ;;
      *.rar)       rar x $1       ;;
      *.gz)        gunzip $1      ;;
      *.xz)        unxz $1        ;;
      *.tar)       tar xvf $1     ;;
      *.tbz2)      tar xvjf $1    ;;
      *.tgz)       tar xvzf $1    ;;
      *.zip)       unzip $1       ;;
      *.Z)         uncompress $1  ;;
      *.7z)        7z x $1        ;;
      *)           echo "don't know how to extract '$1'..." >&2; return 1 ;;
  esac
}

